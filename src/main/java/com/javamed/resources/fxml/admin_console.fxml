<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane prefHeight="650.0" prefWidth="900.0"
            xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.javamed.controllers.AdminConsoleController"
            style="-fx-background-color: #f8fafc;">

    <top>
        <HBox alignment="CENTER_LEFT" spacing="15.0"
              style="-fx-background-color: #475569; -fx-padding: 12 25;">
            <Label text="JavaMed" style="-fx-text-fill: white; -fx-font-size: 20px; -fx-font-weight: bold;"/>
            <Separator orientation="VERTICAL"/>
            <Label fx:id="welcomeLabel" text="System Administration"
                   style="-fx-text-fill: #f1f5f9; -fx-font-size: 14px;"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="Sign Out" onAction="#handleLogout"
                    style="-fx-background-color: #334155; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand; -fx-padding: 6 16; -fx-background-radius: 4;"/>
        </HBox>
    </top>

    <center>
        <VBox spacing="15.0" style="-fx-padding: 20;">
            <HBox alignment="CENTER_LEFT" spacing="10.0">
                <Label text="Pending Account Approvals" 
                       style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #1e293b;"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button text="Approve Selected User" onAction="#handleApproveUser"
                        style="-fx-background-color: #16a34a; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;"/>
                <Button text="Refresh" onAction="#loadPendingUsers"
                        style="-fx-background-color: #e2e8f0; -fx-cursor: hand;"/>
            </HBox>

            <TableView fx:id="pendingUsersTable" VBox.vgrow="ALWAYS"
                       style="-fx-background-color: white; -fx-border-color: #cbd5e1; -fx-border-radius: 4;">
                <columns>
                    <TableColumn fx:id="idCol" text="User ID" prefWidth="70.0"/>
                    <TableColumn fx:id="usernameCol" text="Username" prefWidth="140.0"/>
                    <TableColumn fx:id="nameCol" text="Full Name" prefWidth="180.0"/>
                    <TableColumn fx:id="roleCol" text="Role" prefWidth="120.0"/>
                    <TableColumn fx:id="emailCol" text="Email" prefWidth="220.0"/>
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                </columnResizePolicy>
            </TableView>

            <Label fx:id="feedbackLabel" text="" style="-fx-font-weight: bold;"/>
        </VBox>
    </center>
</BorderPane>