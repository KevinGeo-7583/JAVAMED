<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane prefHeight="750.0" prefWidth="1100.0"
            xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.javamed.controllers.DoctorWorkspaceController"
            style="-fx-background-color: #f8fafc;">

    <!-- Top Navigation Bar -->
    <top>
        <HBox alignment="CENTER_LEFT" spacing="15.0"
              style="-fx-background-color: #0284c7; -fx-padding: 12 25;">
            <Label text="JavaMed" style="-fx-text-fill: white; -fx-font-size: 20px; -fx-font-weight: bold;"/>
            <Separator orientation="VERTICAL"/>
            <Label fx:id="welcomeLabel" text="Doctor Clinical Workspace"
                   style="-fx-text-fill: #e0f2fe; -fx-font-size: 14px;"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="Sign Out" onAction="#handleLogout"
                    style="-fx-background-color: #0369a1; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand; -fx-padding: 6 16; -fx-background-radius: 4;"/>
        </HBox>
    </top>

    <!-- Main Workspace Split -->
    <center>
        <SplitPane dividerPositions="0.38" style="-fx-background-color: transparent; -fx-padding: 15;">
            
            <!-- Left Panel: Patient Directory -->
            <VBox spacing="12.0" style="-fx-padding: 0 10 0 0;">
                <HBox alignment="CENTER_LEFT" spacing="10.0">
                    <Label text="Patient Directory" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #1e293b;"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Button text="Refresh" onAction="#loadPatientData"
                            style="-fx-background-color: #e2e8f0; -fx-text-fill: #334155; -fx-cursor: hand;"/>
                </HBox>

                <TableView fx:id="patientTable" VBox.vgrow="ALWAYS"
                           style="-fx-background-color: white; -fx-border-color: #cbd5e1; -fx-border-radius: 4;">
                    <columns>
                        <TableColumn fx:id="idCol" text="ID" prefWidth="45.0"/>
                        <TableColumn fx:id="nameCol" text="Name" prefWidth="150.0"/>
                        <TableColumn fx:id="emailCol" text="Email" prefWidth="180.0"/>
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                    </columnResizePolicy>
                </TableView>
            </VBox>

            <!-- Right Panel: Record History & New Entry Form -->
            <VBox spacing="14.0" style="-fx-padding: 15; -fx-background-color: white; -fx-border-color: #cbd5e1; -fx-border-radius: 6;">
                
                <!-- Patient Context Banner -->
                <HBox alignment="CENTER_LEFT" spacing="15.0">
                    <Label text="Patient History &amp; Records" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #1e293b;"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label text="Active:" style="-fx-font-weight: bold; -fx-text-fill: #64748b;"/>
                    <Label fx:id="selectedPatientNameLabel" text="None Selected" style="-fx-text-fill: #0284c7; -fx-font-weight: bold;"/>
                </HBox>

                <Separator/>

                <!-- Search Filter & PDF Trigger -->
                <HBox spacing="10.0" alignment="CENTER_LEFT">
                    <TextField fx:id="searchRecordField" promptText="🔍 Search past diagnoses or notes..." HBox.hgrow="ALWAYS"
                               style="-fx-padding: 7; -fx-border-color: #cbd5e1; -fx-border-radius: 4;"/>
                    <Button text="Export Selected to PDF" onAction="#handleExportPdf"
                            style="-fx-background-color: #0f766e; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand; -fx-padding: 7 14; -fx-background-radius: 4;"/>
                </HBox>

                <!-- Patient's Clinical Records Table -->
                <TableView fx:id="clinicalRecordsTable" prefHeight="200.0"
                           style="-fx-background-color: white; -fx-border-color: #cbd5e1; -fx-border-radius: 4;">
                    <columns>
                        <TableColumn fx:id="recordDateCol" text="Date" prefWidth="130.0"/>
                        <TableColumn fx:id="recordDiagnosisCol" text="Diagnosis" prefWidth="170.0"/>
                        <TableColumn fx:id="recordPrescriptionCol" text="Prescription" prefWidth="180.0"/>
                        <TableColumn fx:id="recordNotesCol" text="Notes" prefWidth="160.0"/>
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                    </columnResizePolicy>
                </TableView>

                <Separator/>

                <!-- New Consultation Entry -->
                <Label text="New Consultation Entry" style="-fx-font-weight: bold; -fx-text-fill: #334155;"/>
                
                <GridPane hgap="10" vgap="8">
                    <columnConstraints>
                        <ColumnConstraints minWidth="100"/>
                        <ColumnConstraints hgrow="ALWAYS"/>
                    </columnConstraints>

                    <Label text="Diagnosis:" GridPane.rowIndex="0" GridPane.columnIndex="0" style="-fx-font-weight: bold;"/>
                    <TextField fx:id="diagnosisField" promptText="e.g. Acute Bronchitis" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

                    <Label text="Prescription:" GridPane.rowIndex="1" GridPane.columnIndex="0" style="-fx-font-weight: bold;"/>
                    <TextArea fx:id="prescriptionArea" promptText="Dosage &amp; Medication" prefRowCount="2" wrapText="true" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

                    <Label text="Notes:" GridPane.rowIndex="2" GridPane.columnIndex="0" style="-fx-font-weight: bold;"/>
                    <TextArea fx:id="clinicalNotesArea" promptText="Observations..." prefRowCount="2" wrapText="true" GridPane.rowIndex="2" GridPane.columnIndex="1"/>
                </GridPane>

                <HBox spacing="10.0" alignment="CENTER_RIGHT">
                    <Label fx:id="feedbackLabel" text="" style="-fx-font-weight: bold;" HBox.hgrow="ALWAYS"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Button text="Save Record" onAction="#handleSaveRecord"
                            style="-fx-background-color: #0284c7; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand; -fx-padding: 8 18; -fx-background-radius: 4;"/>
                </HBox>
            </VBox>
        </SplitPane>
    </center>
</BorderPane>