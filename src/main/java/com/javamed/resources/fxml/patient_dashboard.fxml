<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane prefHeight="650.0" prefWidth="900.0"
            xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.javamed.controllers.PatientDashboardController"
            style="-fx-background-color: #f8fafc;">

    <!-- Top Navigation Bar -->
    <top>
        <HBox alignment="CENTER_LEFT" spacing="15.0"
              style="-fx-background-color: #0d9488; -fx-padding: 12 25;">
            <Label text="JavaMed" style="-fx-text-fill: white; -fx-font-size: 20px; -fx-font-weight: bold;"/>
            <Separator orientation="VERTICAL"/>
            <Label fx:id="welcomeLabel" text="Patient Health Portal"
                   style="-fx-text-fill: #ccfbf1; -fx-font-size: 14px;"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="Sign Out" onAction="#handleLogout"
                    style="-fx-background-color: #0f766e; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand; -fx-padding: 6 16; -fx-background-radius: 4;"/>
        </HBox>
    </top>

    <!-- Main Content Area -->
    <center>
        <VBox spacing="15.0" style="-fx-padding: 20;">
            <HBox alignment="CENTER_LEFT" spacing="10.0">
                <Label text="My Medical Records &amp; History" 
                       style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #1e293b;"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button text="Refresh Records" onAction="#loadPatientRecords"
                        style="-fx-background-color: #e2e8f0; -fx-cursor: hand;"/>
            </HBox>

            <!-- Records Table -->
            <TableView fx:id="recordsTable" VBox.vgrow="ALWAYS"
                       style="-fx-background-color: white; -fx-border-color: #cbd5e1; -fx-border-radius: 4;">
                <columns>
                    <TableColumn fx:id="dateCol" text="Date &amp; Time" prefWidth="160.0"/>
                    <TableColumn fx:id="doctorCol" text="Doctor ID" prefWidth="90.0"/>
                    <TableColumn fx:id="diagnosisCol" text="Diagnosis" prefWidth="200.0"/>
                    <TableColumn fx:id="prescriptionCol" text="Prescription" prefWidth="250.0"/>
                    <TableColumn fx:id="notesCol" text="Clinical Notes" prefWidth="250.0"/>
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                </columnResizePolicy>
            </TableView>
        </VBox>
    </center>
</BorderPane>